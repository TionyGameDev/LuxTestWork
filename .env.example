# Скопируйте в .env и заполните. Файл .env в git не попадает.
# Вариант 1: Anthropic (--provider llm)
ANTHROPIC_API_KEY=
# Вариант 2: любой OpenAI-совместимый API, например OpenRouter (--provider openai)
LLM_API_KEY=
# необязательно: по умолчанию https://openrouter.ai/api/v1
LLM_BASE_URL=
# необязательно: модель (по умолчанию claude-haiku-5-5 для llm, google/gemma-4-26b-a4b-it:free для openai)
REVIEW_LLM_MODEL=
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=
